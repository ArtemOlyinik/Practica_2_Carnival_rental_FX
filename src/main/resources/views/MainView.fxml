<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oliinyk.costumes.view.MainController">
    <!-- Sidebar -->
    <left>
        <VBox spacing="15" style="-fx-background-color: -color-bg-inset; -fx-padding: 20; -fx-border-color: transparent -color-border-default transparent transparent; -fx-border-width: 1; -fx-pref-width: 250;">
            <Label text="Carnival" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: -color-accent-emphasis;">
                <graphic>
                    <FontIcon iconLiteral="fas-mask" iconColor="#005fb8" />
                </graphic>
            </Label>
            
            <Separator />
            
            <Button fx:id="btnCatalog" text="Каталог" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showCatalog" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-list" />
                </graphic>
            </Button>
            <Button fx:id="btnBasket" text="Кошик" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showBasket" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-shopping-cart" />
                </graphic>
            </Button>
            <Button fx:id="btnMyRentals" text="Мої Оренди" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showMyRentals" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-history" />
                </graphic>
            </Button>
            <Button fx:id="btnAdmin" text="Адмін Панель" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showAdminPanel" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-user-shield" />
                </graphic>
            </Button>
            <Button fx:id="btnSettings" text="Налаштування" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showSettings" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-cog" />
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button text="Вийти" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#logout" styleClass="danger">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" />
                </graphic>
            </Button>
        </VBox>
    </left>
    
    <!-- Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: -color-bg-default;" />
    </center>
</BorderPane>
